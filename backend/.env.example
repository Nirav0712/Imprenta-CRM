# ==============================================================================
# AutoMarket CRM — Environment Configuration Template
# ==============================================================================

# Server & Network Configuration
PORT=4000
NODE_ENV=production
FRONTEND_URL=https://crm.imprenta.in
ALLOWED_ORIGINS=https://crm.imprenta.in

# Database Configuration (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.example.mongodb.net/automarket?retryWrites=true&w=majority
MONGODB_DB_NAME=automarket

# Cryptography & Security Keys
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=<64_hex_character_encryption_key>
JWT_SECRET=<64_hex_character_jwt_secret>
API_KEY=<64_hex_character_api_key>
DEFAULT_ORGANIZATION_ID=default-org

# WhatsApp Meta Cloud API Webhook Verification
META_VERIFY_TOKEN=<your_meta_webhook_verify_token>

# Sending Queue Engine Defaults
DEFAULT_SENDING_DELAY_SEC=2
DEFAULT_BATCH_SIZE=50
DEFAULT_BATCH_PAUSE_SEC=60

# Optional Email Integrations (Zoho Mail)
ZOHO_ACCOUNT_NAME=Your Company Name
ZOHO_EMAIL=info@yourdomain.com
ZOHO_SENDER_NAME=Your Company Name
ZOHO_SMTP_HOST=smtp.zoho.in
ZOHO_SMTP_PORT=465
ZOHO_SMTP_SECURE=true
ZOHO_SMTP_USER=info@yourdomain.com
ZOHO_SMTP_PASSWORD=<your_zoho_app_password>
ZOHO_IMAP_HOST=imap.zoho.in
ZOHO_IMAP_PORT=993
ZOHO_IMAP_SECURE=true

# Optional Email Integrations (Gmail)
GMAIL_ACCOUNT_NAME=Your Team Name
GMAIL_EMAIL=yourname@gmail.com
GMAIL_SENDER_NAME=Your Team Name
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_SMTP_SECURE=false
GMAIL_SMTP_USER=yourname@gmail.com
GMAIL_SMTP_PASSWORD=<your_gmail_app_password>
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_PORT=993
GMAIL_IMAP_SECURE=true
GMAIL_IMAP_USER=yourname@gmail.com
GMAIL_IMAP_PASSWORD=<your_gmail_app_password>
