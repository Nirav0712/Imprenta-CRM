PORT=4000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/automarket?retryWrites=true&w=majority
MONGODB_DB_NAME=automarket
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
META_VERIFY_TOKEN=your_meta_verify_token_here
DEFAULT_SENDING_DELAY_SEC=2
DEFAULT_BATCH_SIZE=50
DEFAULT_BATCH_PAUSE_SEC=60

# Email Integration (Optional)
ZOHO_ACCOUNT_NAME=Your Zoho Account
ZOHO_EMAIL=info@example.com
ZOHO_SENDER_NAME=AutoMarket
ZOHO_SMTP_HOST=smtp.zoho.in
ZOHO_SMTP_PORT=465
ZOHO_SMTP_SECURE=true
ZOHO_SMTP_USER=info@example.com
ZOHO_SMTP_PASSWORD=your_zoho_app_password
ZOHO_IMAP_HOST=imap.zoho.in
ZOHO_IMAP_PORT=993
ZOHO_IMAP_SECURE=true
